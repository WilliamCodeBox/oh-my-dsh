{
  "name": "@williamcodebox/omd-acp",
  "description": "Automation-only Agent Client Protocol server for driving DeepSeek Harness agents over JSON-RPC stdio",
  "version": "0.1.0-rc.6",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WilliamCodeBox/oh-my-dsh.git",
    "directory": "packages/acp/acp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "0.25.1",
    "@williamcodebox/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@williamcodebox/omd-agent": "workspace:^",
    "@williamcodebox/omd-invariants": "workspace:^",
    "@williamcodebox/omd-session": "workspace:^",
    "@williamcodebox/omd-user-approval": "workspace:^",
    "@williamcodebox/cordis": "workspace:^"
  },
  "devDependencies": {
    "@williamcodebox/omd-agent": "workspace:^",
    "@williamcodebox/omd-agent-loop": "workspace:^",
    "@williamcodebox/omd-agent-loop-testkit": "workspace:^",
    "@williamcodebox/omd-invariants": "workspace:^",
    "@williamcodebox/omd-llm": "workspace:^",
    "@williamcodebox/omd-session": "workspace:^",
    "@williamcodebox/omd-tools": "workspace:^",
    "@williamcodebox/omd-user-approval": "workspace:^",
    "@williamcodebox/cordis": "workspace:^"
  }
}
