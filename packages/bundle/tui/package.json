{
  "name": "@williamcodebox/omd-tui",
  "description": "The dsh interactive terminal surface bundle: a TUI front door over dsh-base",
  "version": "0.1.0-rc.9",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WilliamCodeBox/oh-my-dsh.git",
    "directory": "packages/bundle/tui"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/startup.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@williamcodebox/omd-agent-presets": "workspace:^",
    "@williamcodebox/omd-cmdline": "workspace:^",
    "@williamcodebox/omd-client-trajectory-model": "workspace:^",
    "@williamcodebox/omd-tui-renderer": "workspace:^",
    "@williamcodebox/schemastery": "workspace:^",
    "commander": "^15.0.0",
    "@williamcodebox/omd-lsp-stdio": "workspace:^",
    "typescript-language-server": "^5.3.0",
    "typescript": "^5.7.2"
  },
  "peerDependencies": {
    "@williamcodebox/cordis-plugin-loader": "workspace:^",
    "@williamcodebox/omd-agent": "workspace:^",
    "@williamcodebox/omd-agent-default-model": "workspace:^",
    "@williamcodebox/omd-commands": "workspace:^",
    "@williamcodebox/omd-invariants": "workspace:^",
    "@williamcodebox/omd-llm": "workspace:^",
    "@williamcodebox/omd-permission-presets": "workspace:^",
    "@williamcodebox/omd-session": "workspace:^",
    "@williamcodebox/omd-user-approval": "workspace:^",
    "@williamcodebox/omd-user-questions": "workspace:^",
    "@williamcodebox/cordis": "workspace:^"
  },
  "devDependencies": {
    "@williamcodebox/cordis-plugin-loader": "workspace:^",
    "@williamcodebox/omd-agent": "workspace:^",
    "@williamcodebox/omd-agent-default-model": "workspace:^",
    "@williamcodebox/omd-commands": "workspace:^",
    "@williamcodebox/omd-invariants": "workspace:^",
    "@williamcodebox/omd-llm": "workspace:^",
    "@williamcodebox/omd-permission-presets": "workspace:^",
    "@williamcodebox/omd-session": "workspace:^",
    "@williamcodebox/omd-user-approval": "workspace:^",
    "@williamcodebox/omd-user-questions": "workspace:^",
    "@williamcodebox/cordis": "workspace:^"
  }
}