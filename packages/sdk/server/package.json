{
  "name": "@williamcodebox/omd-sdk-jsonrpc-server",
  "description": "Stdio JSON-RPC server plugin for out-of-process DeepSeek Harness SDK clients",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/sdk/server"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@williamcodebox/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@williamcodebox/omd-agent": "workspace:^",
    "@williamcodebox/omd-invariants": "workspace:^",
    "@williamcodebox/omd-llm": "workspace:^",
    "@williamcodebox/omd-llm-deepseek": "workspace:^",
    "@williamcodebox/omd-scope": "workspace:^",
    "@williamcodebox/omd-sdk-protocol": "workspace:^",
    "@williamcodebox/omd-session": "workspace:^",
    "@williamcodebox/omd-subagent": "workspace:^",
    "@williamcodebox/cordis": "workspace:^"
  },
  "devDependencies": {
    "@williamcodebox/cordis-plugin-loader": "workspace:^",
    "@williamcodebox/omd-agent": "workspace:^",
    "@williamcodebox/omd-agent-spine-demo": "workspace:^",
    "@williamcodebox/omd-invariants": "workspace:^",
    "@williamcodebox/omd-llm": "workspace:^",
    "@williamcodebox/omd-llm-deepseek": "workspace:^",
    "@williamcodebox/omd-scope": "workspace:^",
    "@williamcodebox/omd-sdk-protocol": "workspace:^",
    "@williamcodebox/omd-session": "workspace:^",
    "@williamcodebox/omd-session-persistence-jsonl": "workspace:^",
    "@williamcodebox/omd-subagent": "workspace:^",
    "@williamcodebox/cordis": "workspace:^"
  }
}
