{
  "name": "@williamcodebox/omd-tool-lsp",
  "description": "Model-facing lsp tool over the DeepSeek Harness LSP capability seam (ctx.lsp) — one read-only tool with goToDefinition/findReferences/goToImplementation/hover operations, one-based UTF-16 cursor coordinates, bounded location rendering, and hover normalization",
  "version": "0.1.0-rc.9",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WilliamCodeBox/oh-my-dsh.git",
    "directory": "packages/lsp/tool-lsp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@williamcodebox/omd-invariants": "workspace:^",
    "@williamcodebox/omd-llm": "workspace:^",
    "@williamcodebox/omd-lsp": "workspace:^",
    "@williamcodebox/omd-system-prompt": "workspace:^",
    "@williamcodebox/omd-timeout": "workspace:^",
    "@williamcodebox/omd-tools": "workspace:^",
    "@williamcodebox/cordis": "workspace:^"
  },
  "dependencies": {
    "@williamcodebox/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@williamcodebox/omd-agent": "workspace:^",
    "@williamcodebox/omd-fs-local": "workspace:^",
    "@williamcodebox/omd-invariants": "workspace:^",
    "@williamcodebox/omd-llm": "workspace:^",
    "@williamcodebox/omd-lsp": "workspace:^",
    "@williamcodebox/omd-lsp-stdio": "workspace:^",
    "@williamcodebox/omd-session": "workspace:^",
    "@williamcodebox/omd-subprocess-local": "workspace:^",
    "@williamcodebox/omd-system-prompt": "workspace:^",
    "@williamcodebox/omd-timeout": "workspace:^",
    "@williamcodebox/omd-tool-call-timeout-policy": "workspace:^",
    "@williamcodebox/omd-tools": "workspace:^",
    "@williamcodebox/cordis": "workspace:^"
  }
}
