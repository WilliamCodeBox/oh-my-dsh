{
  "name": "@williamcodebox/omd-tui-renderer",
  "description": "Folded terminal transcript model and presentation seam for the dsh TUI surface",
  "version": "0.1.0-rc.6",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WilliamCodeBox/oh-my-dsh.git",
    "directory": "packages/interaction/tui-renderer"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./transcript": {
      "types": "./lib/types/transcript.d.ts",
      "default": "./lib/types/transcript.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@williamcodebox/cordis": "workspace:^",
    "@williamcodebox/omd-commands": "workspace:^",
    "@williamcodebox/omd-invariants": "workspace:^",
    "@williamcodebox/omd-llm": "workspace:^",
    "@williamcodebox/omd-session": "workspace:^",
    "@williamcodebox/omd-user-approval": "workspace:^",
    "@williamcodebox/omd-user-questions": "workspace:^"
  },
  "devDependencies": {
    "@williamcodebox/cordis": "workspace:^",
    "@williamcodebox/omd-commands": "workspace:^",
    "@williamcodebox/omd-invariants": "workspace:^",
    "@williamcodebox/omd-llm": "workspace:^",
    "@williamcodebox/omd-session": "workspace:^",
    "@williamcodebox/omd-user-approval": "workspace:^",
    "@williamcodebox/omd-user-questions": "workspace:^"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "0.84.2"
  }
}
