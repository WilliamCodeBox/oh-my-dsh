{
  "name": "@williamcodebox/omd-host-apiproxy",
  "description": "API gateway: the ApiProxy contract (api/), the fetch carrier pair (fetch/), and the host-side gateway plugin providing ctx.apiProxy",
  "version": "0.1.0-rc.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WilliamCodeBox/oh-my-dsh.git",
    "directory": "packages/host/apiproxy"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./api": {
      "types": "./lib/types/api/index.d.ts",
      "default": "./lib/types/api/index.js"
    },
    "./api/*": {
      "types": "./lib/types/api/*.d.ts",
      "default": "./lib/types/api/*.js"
    },
    "./client": {
      "types": "./lib/types/fetch/client.d.ts",
      "default": "./lib/types/fetch/client.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@williamcodebox/omd-attachment": "workspace:^",
    "@williamcodebox/omd-agent": "workspace:^",
    "@williamcodebox/omd-agent-default-model": "workspace:^",
    "@williamcodebox/omd-api-remotes": "workspace:^",
    "@williamcodebox/omd-brand": "workspace:^",
    "@williamcodebox/omd-commands": "workspace:^",
    "@williamcodebox/omd-credentials": "workspace:^",
    "@williamcodebox/omd-goal": "workspace:^",
    "@williamcodebox/omd-host-directory-picker": "workspace:^",
    "@williamcodebox/omd-llm": "workspace:^",
    "@williamcodebox/omd-native-command": "workspace:^",
    "@williamcodebox/omd-session": "workspace:^",
    "@williamcodebox/omd-session-persistence": "workspace:^",
    "@williamcodebox/omd-session-projection": "workspace:^",
    "@williamcodebox/omd-session-projection-cache": "workspace:^",
    "@williamcodebox/omd-session-query": "workspace:^",
    "@williamcodebox/omd-session-title": "workspace:^",
    "@williamcodebox/omd-settings": "workspace:^",
    "@williamcodebox/omd-skill": "workspace:^",
    "@williamcodebox/omd-subagent": "workspace:^",
    "@williamcodebox/omd-jobs": "workspace:^",
    "@williamcodebox/omd-tools": "workspace:^",
    "@williamcodebox/omd-user-approval": "workspace:^",
    "@williamcodebox/omd-user-questions": "workspace:^",
    "@williamcodebox/omd-workspace": "workspace:^",
    "@williamcodebox/schemastery": "workspace:^",
    "fflate": "^0.8.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@williamcodebox/cordis": "workspace:^",
    "@williamcodebox/omd-agent-presets": "workspace:^",
    "@williamcodebox/omd-cordis-host-runner": "workspace:^",
    "@williamcodebox/omd-invariants": "workspace:^"
  },
  "devDependencies": {
    "@williamcodebox/cordis": "workspace:^",
    "@williamcodebox/omd-agent-presets": "workspace:^",
    "@williamcodebox/omd-cordis-host-runner": "workspace:^",
    "@williamcodebox/omd-invariants": "workspace:^",
    "@williamcodebox/omd-storage": "workspace:^",
    "@williamcodebox/omd-storage-domain": "workspace:^",
    "@williamcodebox/omd-typert-protocol": "workspace:^",
    "@williamcodebox/omd-typert-registry": "workspace:^",
    "@williamcodebox/cordis": "workspace:^"
  }
}
