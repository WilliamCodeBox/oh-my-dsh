{
  "name": "@williamcodebox/omd-tool-bash",
  "description": "Model-facing bash tool with optional generic background-job and sandbox-escalation support",
  "version": "0.1.0-rc.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WilliamCodeBox/oh-my-dsh.git",
    "directory": "packages/shell/tool-bash"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@williamcodebox/omd-agent": "workspace:^",
    "@williamcodebox/omd-shell": "workspace:^",
    "@williamcodebox/omd-shell-env": "workspace:^",
    "@williamcodebox/omd-invariants": "workspace:^",
    "@williamcodebox/omd-llm": "workspace:^",
    "@williamcodebox/omd-sandbox": "workspace:^",
    "@williamcodebox/omd-sandbox-policy": "workspace:^",
    "@williamcodebox/omd-system-prompt": "workspace:^",
    "@williamcodebox/omd-jobs": "workspace:^",
    "@williamcodebox/omd-tools": "workspace:^",
    "@williamcodebox/omd-user-approval": "workspace:^",
    "@williamcodebox/cordis": "workspace:^"
  },
  "dependencies": {
    "@williamcodebox/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@williamcodebox/omd-agent": "workspace:^",
    "@williamcodebox/omd-agent-loop": "workspace:^",
    "@williamcodebox/omd-agent-loop-testkit": "workspace:^",
    "@williamcodebox/omd-shell": "workspace:^",
    "@williamcodebox/omd-shell-env": "workspace:^",
    "@williamcodebox/omd-bash-local": "workspace:^",
    "@williamcodebox/omd-invariants": "workspace:^",
    "@williamcodebox/omd-llm": "workspace:^",
    "@williamcodebox/omd-subprocess-local": "workspace:^",
    "@williamcodebox/omd-sandbox": "workspace:^",
    "@williamcodebox/omd-sandbox-policy": "workspace:^",
    "@williamcodebox/omd-session": "workspace:^",
    "@williamcodebox/omd-session-persistence-jsonl": "workspace:^",
    "@williamcodebox/omd-system-prompt": "workspace:^",
    "@williamcodebox/omd-jobs": "workspace:^",
    "@williamcodebox/omd-jobs-local": "workspace:^",
    "@williamcodebox/omd-tool-jobs": "workspace:^",
    "@williamcodebox/omd-tools": "workspace:^",
    "@williamcodebox/omd-user-approval": "workspace:^",
    "@williamcodebox/cordis": "workspace:^"
  }
}
